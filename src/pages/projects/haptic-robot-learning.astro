---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import DemoVideo from '../../components/media/DemoVideo.astro';
import { siteUrl } from '../../utils/urls';
const entry = (await getEntry('projects', 'haptic-robot-learning'))!;
const { Content } = await render(entry);
const project = entry.data;
---
<BaseLayout title={project.title} description={project.summary!}>
  <article class="page-shell robot-page">
    <a href={siteUrl('/projects/')} class="back">← All projects</a>
    <header><p class="eyebrow">Research / Robot learning</p><h1>{project.title}</h1><p class="intro">{project.summary}</p><ul class="tags">{project.tags.map(tag => <li>{tag}</li>)}</ul></header>
    <section class="overview"><h2>Current public record</h2><div><Content /></div></section>
    <section aria-labelledby="demonstrations"><h2 id="demonstrations">Two views of the setup</h2><div class="videos">{project.demonstrations.map(demo => <DemoVideo {...demo} />)}</div><p class="media-note">Silent demonstration clips. Use the player controls to play, pause, or view fullscreen.</p></section>
    <footer class="project-footer"><a href={siteUrl('/projects/')}>← Back to projects</a><span>SO101 · Teleoperation · Demonstration</span></footer>
  </article>
</BaseLayout>
<style>
  .robot-page {padding-top:3rem}.back {font-size:.9rem} header {margin:3rem 0} h1 {font-size:clamp(2.8rem,7vw,5.5rem);max-width:17ch} .tags {list-style:none;display:flex;gap:.7rem 1.5rem;flex-wrap:wrap;padding:1rem 0;border-block:1px solid var(--line);margin-top:2rem;font-size:.9rem;color:var(--muted)} h2 {font-size:clamp(1.5rem,3vw,2rem);line-height:1.25;letter-spacing:-.025em}.overview {display:grid;grid-template-columns:1fr 1.5fr;gap:3rem;margin:3rem 0}.overview h2 {margin-top:0}.overview :global(p) {margin-top:0;color:var(--muted)}.videos {display:grid;grid-template-columns:1fr 1.3fr;gap:2rem;align-items:start}.media-note {color:var(--muted);font-size:.9rem;margin-top:2rem}.project-footer {display:flex;justify-content:space-between;gap:1rem;flex-wrap:wrap;border-top:1px solid var(--line);padding-top:2rem;margin-top:3rem;font-size:.9rem}.project-footer span {color:var(--muted)}@media(max-width:640px){.overview,.videos {grid-template-columns:1fr;gap:1.5rem}}
</style>
