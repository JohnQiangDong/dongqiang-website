---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection, getEntry } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { siteUrl } from '../utils/urls';

const lines = (await getCollection('research')).sort((a, b) => (a.data.order ?? 999) - (b.data.order ?? 999));
const projects = new Map<string, CollectionEntry<'projects'>['data']>();
const publications = new Map<string, CollectionEntry<'publications'>['data']>();

for (const line of lines) {
  projects.set(line.data.project, (await getEntry('projects', line.data.project))!.data);
  if (line.data.publication) publications.set(line.data.publication, (await getEntry('publications', line.data.publication))!.data);
}

const stageLabel = (stage?: string) => stage === 'early-stage' ? 'Emerging research direction' : 'Current research direction';
---

<BaseLayout title="Research" description="Long-term research directions in MR haptic feedback and robot imitation learning.">
  <section class="page-shell research-page">
    <header>
      <p class="eyebrow">Research</p>
      <h1>Research directions</h1>
      <p class="intro">My research connects programmable physical feedback with human–robot interaction and robot learning.</p>
    </header>

    <div class="research-lines">
      {lines.map((line, index) => {
        const project = projects.get(line.data.project)!;
        const publication = line.data.publication ? publications.get(line.data.publication) : undefined;
        return (
          <article class="research-line" id={line.data.slug}>
            <div class="line-heading">
              <p class="line-number">{String(index + 1).padStart(2, '0')}</p>
              <div><p class="eyebrow">{stageLabel(line.data.stage)}</p><h2>{line.data.title}</h2><p class="summary">{line.data.summary}</p></div>
            </div>

            <div class="question"><p class="label">Research question</p><p>{line.data.question}</p></div>

            <div class="line-body">
              <section>
                <p class="label">Current work</p>
                <p>{line.data.currentEvidence}</p>
                <div class="links">
                  <a href={siteUrl(`/projects/${line.data.project}/`)}>Current project: {project.title} ↗</a>
                  {publication && <a href={publication.paper} target="_blank" rel="noopener noreferrer">Related preprint ↗</a>}
                </div>
              </section>
              <section>
                <p class="label">Future direction</p>
                <ul>{line.data.agenda.map((item) => <li>{item}</li>)}</ul>
              </section>
            </div>

            {line.data.slug === 'mr-haptic-feedback' ? (
              <figure class="evidence-media single">
                <img src={siteUrl(project.hero!.source)} alt={project.hero!.alt} width="1800" height="1903" loading="lazy" />
                <figcaption>The current actuator project supports the broader MR haptic feedback direction.</figcaption>
              </figure>
            ) : (
              <div class="evidence-media video-posters" aria-label="Current evidence: two SO101 teleoperation demonstration views">
                {project.demonstrations.map((demo) => (
                  <figure><img src={siteUrl(demo.poster)} alt={`${demo.title}: ${demo.description}`} width={demo.width} height={demo.height} loading="lazy" /><figcaption>{demo.title}</figcaption></figure>
                ))}
              </div>
            )}
          </article>
        );
      })}
    </div>

  </section>
</BaseLayout>

<style>
  .research-page {padding-top:clamp(3.5rem,7vw,6rem)}header {padding-bottom:4rem;border-bottom:1px solid var(--line)}header h1 {max-width:18ch}.research-lines {display:grid}.research-line {padding:5rem 0;border-bottom:1px solid var(--line)}.line-heading {display:grid;grid-template-columns:5rem 1fr;gap:2rem}.line-number {margin:0;color:var(--accent);font-size:1rem;font-weight:760}.line-heading h2 {max-width:16ch;margin:0;font-size:clamp(2.5rem,6vw,5rem);line-height:1;letter-spacing:-.055em}.summary {max-width:45rem;color:var(--muted);font-size:1.15rem}.question {display:grid;grid-template-columns:12rem 1fr;gap:2rem;margin:3rem 0;padding:1.5rem 0;border-block:1px solid var(--line)}.question>p:last-child {max-width:52rem;margin:0;font-size:clamp(1.25rem,2.5vw,1.7rem);line-height:1.45;letter-spacing:-.02em}.label {margin:0;color:var(--accent);font-size:.76rem;font-weight:760;letter-spacing:.11em;text-transform:uppercase}.line-body {display:grid;grid-template-columns:1fr 1fr;gap:clamp(2rem,6vw,5rem)}.line-body section>p:not(.label),.line-body li {color:var(--muted)}.line-body ul {margin:1rem 0 0;padding-left:1.2rem}.line-body li+li {margin-top:.65rem}.links {display:flex;flex-wrap:wrap;gap:.6rem 1.5rem;margin-top:1.25rem;font-size:.9rem}.evidence-media {margin-top:3rem}.evidence-media img {display:block;width:100%;height:auto;background:var(--soft)}.evidence-media figcaption {margin-top:.6rem;color:var(--muted);font-size:.85rem}.single {display:grid;grid-template-columns:minmax(0,1fr) 14rem;gap:1.5rem;align-items:end}.single img {max-height:34rem;object-fit:contain}.video-posters {display:grid;grid-template-columns:.6fr 1.4fr;gap:1.5rem;align-items:end}.video-posters figure {margin:0}.video-posters figure:first-child img {aspect-ratio:9/16;object-fit:cover}.video-posters figure:last-child img {aspect-ratio:16/9;object-fit:cover}@media(max-width:720px){header {padding-bottom:3rem}.research-line {padding:3rem 0}.line-heading {grid-template-columns:1fr;gap:.7rem}.question {grid-template-columns:1fr;gap:.75rem}.line-body,.single {grid-template-columns:1fr}.video-posters {grid-template-columns:1fr 1fr;align-items:start}}
</style>
