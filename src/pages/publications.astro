---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection, getEntry } from 'astro:content';

const publications = (await getCollection('publications')).sort((a, b) =>
  (b.data.year ?? 0) - (a.data.year ?? 0) || (a.data.order ?? 999) - (b.data.order ?? 999)
);

const projectNames = new Map<string, string>();
for (const publication of publications) {
  if (publication.data.project && !projectNames.has(publication.data.project)) {
    const project = await getEntry('projects', publication.data.project);
    if (project) projectNames.set(publication.data.project, project.data.title);
  }
}

const venueLine = (publication: (typeof publications)[number]) => {
  const { venue, volume, issue, pages, articleNumber } = publication.data;
  const volumeIssue = [volume, issue ? `(${issue})` : ''].join('');
  const locator = pages ?? articleNumber;
  return [venue, volumeIssue, locator].filter(Boolean).join(', ');
};
---

<BaseLayout title="Publications" description="Academic publications by Dong Qiang.">
  <section class="page-shell publications-page">
    <header>
      <p class="eyebrow">Publications</p>
      <h1>Academic work</h1>
      <p class="intro">Research articles, reviews, and preprints. Publication records are kept separately from the projects they support.</p>
    </header>

    <div class="year-group">
      <h2>2026</h2>
      <ol class="publication-list">
        {publications.map((publication) => (
          <li>
            <article>
              <p class="publication-type">{publication.data.status === 'preprint' ? 'Preprint' : publication.data.type === 'review' ? 'Review' : 'Research article'}</p>
              <h3>{publication.data.title}</h3>
              <p class="authors">
                {publication.data.authors.map((author, index) => (
                  <><span class:list={{ 'site-author': author === 'Dong Qiang' }}>{author}</span>{index < publication.data.authors.length - 1 ? ', ' : ''}</>
                ))}
              </p>
              <p class="venue">{venueLine(publication)} · {publication.data.year}</p>
              <div class="publication-links">
                {publication.data.paper && <a href={publication.data.paper} target="_blank" rel="noopener noreferrer">{publication.data.arxiv ? 'arXiv' : 'Paper'} ↗</a>}
                {publication.data.doi && <span>DOI: {publication.data.doi}</span>}
                {publication.data.project && projectNames.has(publication.data.project) && <span>Related project: {projectNames.get(publication.data.project)}</span>}
              </div>
            </article>
          </li>
        ))}
      </ol>
    </div>
  </section>
</BaseLayout>

<style>
  .publications-page {padding-top:clamp(3.5rem,7vw,6rem)}
  header {padding-bottom:3rem;border-bottom:1px solid var(--line)}
  .year-group {display:grid;grid-template-columns:8rem 1fr;gap:2rem;padding-top:2.5rem}
  h2 {margin:0;font-size:1rem;color:var(--muted);font-variant-numeric:tabular-nums}
  .publication-list {list-style:none;margin:0;padding:0}
  .publication-list li {border-top:1px solid var(--line);padding:2rem 0}
  .publication-list li:first-child {border-top:0;padding-top:0}
  .publication-type {margin:0 0 .55rem;color:var(--accent);font-size:.76rem;font-weight:750;letter-spacing:.1em;text-transform:uppercase}
  h3 {max-width:52rem;margin:0;font-size:clamp(1.25rem,2.5vw,1.65rem);line-height:1.35;letter-spacing:-.02em}
  .authors,.venue {margin:.65rem 0 0;color:var(--muted)}
  .authors {font-size:.98rem}.venue {font-size:.9rem;font-style:italic}
  .site-author {color:var(--ink);font-weight:700}
  .publication-links {display:flex;flex-wrap:wrap;gap:.5rem 1.5rem;margin-top:1rem;font-size:.86rem}
  .publication-links span {color:var(--muted)}
  @media(max-width:640px){.year-group{grid-template-columns:1fr;gap:1rem}.publication-list li:first-child{border-top:1px solid var(--line);padding-top:2rem}}
</style>
