---
import { siteUrl } from '../../utils/urls';
interface Props { title: string; description: string; source: string; webm?: string; poster: string; width: number; height: number }
const { title, description, source, webm, poster, width, height } = Astro.props;
---
<figure>
  <video controls playsinline preload="none" poster={siteUrl(poster)} width={width} height={height} aria-label={title}>
    {webm && <source src={siteUrl(webm)} type='video/webm; codecs="vp9"' />}
    <source src={siteUrl(source)} type="video/mp4" />
    <a href={siteUrl(source)}>Open the video</a>
  </video>
  <figcaption><h3>{title}</h3><p>{description}</p><a href={siteUrl(source)}>Open video separately ↗</a></figcaption>
</figure>
<style>
  figure {margin:0;min-width:0} video {display:block;width:100%;height:auto;max-height:36rem;object-fit:contain;background:#101820} h3 {font-size:1.2rem;margin:1rem 0 .35rem} p {margin:0 0 .5rem;color:var(--muted)} a {font-size:.9rem}
</style>
