---
import Header from '../components/navigation/Header.astro';
import Footer from '../components/common/Footer.astro';
import { zhTranslations } from '../i18n/zh';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const pageTitle = title === 'Home' ? 'Dong Qiang' : `${title} · Dong Qiang`;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const faviconHref = `${base}favicon/site.svg`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en" data-default-language="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href={faviconHref} />
    <title>{pageTitle}</title>
    <script is:inline>
      (() => {
        const requested = new URLSearchParams(location.search).get('lang');
        let saved = null;
        try { saved = localStorage.getItem('site-language'); } catch {}
        const language = requested === 'zh' || requested === 'en'
          ? requested
          : saved === 'zh' || saved === 'en'
            ? saved
            : navigator.language.toLowerCase().startsWith('zh') ? 'zh' : 'en';
        document.documentElement.lang = language === 'zh' ? 'zh-CN' : 'en';
        document.documentElement.dataset.language = language;
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <script is:inline define:vars={{ zhTranslations }}>
      (() => {
        const root = document.documentElement;
        const language = root.dataset.language || 'en';
        const button = document.querySelector('[data-language-toggle]');
        const translate = (value) => {
          const leading = value.match(/^\s*/)?.[0] || '';
          const trailing = value.match(/\s*$/)?.[0] || '';
          const core = value.trim();
          if (!core) return value;
          let translated = zhTranslations[core];
          if (!translated) {
            const indexedLabel = core.match(/^(\d{2}\s*\/\s*)(.+)$/);
            if (indexedLabel && zhTranslations[indexedLabel[2]]) translated = `${indexedLabel[1]}${zhTranslations[indexedLabel[2]]}`;
          }
          if (!translated && core.includes(' · ')) {
            const parts = core.split(' · ');
            const translatedParts = parts.map((part) => zhTranslations[part] || part);
            if (translatedParts.some((part, index) => part !== parts[index])) translated = translatedParts.join(' · ');
          }
          if (!translated) {
            translated = core
              .replace('Related project:', '相关项目：')
              .replace('All projects', '全部项目')
              .replace('Back to projects', '返回项目列表')
              .replace('Present', '至今');
          }
          return `${leading}${translated}${trailing}`;
        };
        const translateNode = (node) => {
          if (node.nodeType === Node.TEXT_NODE) {
            const parent = node.parentElement;
            if (parent && !parent.closest('script, style, noscript, code, pre')) {
              const translated = translate(node.nodeValue || '');
              if (translated !== node.nodeValue) node.nodeValue = translated;
            }
            return;
          }
          if (!(node instanceof Element)) return;
          const translateAttributes = (element) => {
            for (const attribute of ['alt', 'title', 'aria-label', 'aria-roledescription']) {
              if (element.hasAttribute(attribute)) element.setAttribute(attribute, translate(element.getAttribute(attribute) || ''));
            }
          };
          translateAttributes(node);
          for (const element of node.querySelectorAll('[alt], [title], [aria-label], [aria-roledescription]')) translateAttributes(element);
          const walker = document.createTreeWalker(node, NodeFilter.SHOW_TEXT);
          let textNode;
          while ((textNode = walker.nextNode())) translateNode(textNode);
        };
        if (language === 'zh') {
          translateNode(document.body);
          document.title = document.title
            .replace('Home', '首页')
            .replace('Projects & Research', '项目与研究')
            .replace('Publications', '论文发表')
            .replace('Journey', '经历')
            .replace('About', '关于')
            .replace('CV', '简历')
            .replace('Page not found', '页面未找到')
            .replace('Dong Qiang', '董强');
          const description = document.querySelector('meta[name="description"]');
          if (description) description.setAttribute('content', translate(description.getAttribute('content') || ''));
          const observer = new MutationObserver((mutations) => {
            for (const mutation of mutations) {
              if (mutation.type === 'characterData') translateNode(mutation.target);
              for (const node of mutation.addedNodes) translateNode(node);
            }
          });
          observer.observe(document.body, { childList: true, characterData: true, subtree: true });
        }
        if (button) {
          button.textContent = language === 'zh' ? 'EN' : '中文';
          button.setAttribute('aria-label', language === 'zh' ? 'Switch to English' : '切换到中文');
          button.addEventListener('click', () => {
            const next = language === 'zh' ? 'en' : 'zh';
            try { localStorage.setItem('site-language', next); } catch {}
            const url = new URL(location.href);
            url.searchParams.set('lang', next);
            location.assign(url);
          });
        }
      })();
    </script>
  </body>
</html>
